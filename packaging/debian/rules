#!/usr/bin/make -f
# chwrite has no compiled artifacts and no build step to run here: the
# distributable is chwrite.py, a committed, pre-built single-file bundle
# (SPEC.md section 26.1, regenerated by `just build` / scripts/bundle.py
# from src/chwrite/ as part of this repo's own dev workflow, never at
# package-build time). This package is a thin installer around that
# bundle plus the existing POSIX launcher shim (./chwrite) -- it does not
# invoke setuptools/hatchling/pip (that is the separate PyPI packaging
# surface, packaging README section "pip / pipx (PyPI)"; the two are
# independent, equally-valid distribution paths, see SPEC.md section 31).
#
# debian/install (below) does the actual file placement; every
# dh_auto_* step is a deliberate no-op so dh's default Python
# build-system autodetection (which would otherwise try to run
# `pip install .` against this repo's pyproject.toml) never fires.

%:
	dh $@

override_dh_auto_configure:
	# nothing to configure

override_dh_auto_build:
	# nothing to build -- chwrite.py is already a built artifact

override_dh_auto_test:
	# Smoke test only. The real test suite (pytest, SPEC.md section 27)
	# pulls in dev-only tooling (uv/ruff/pyright/pytest) this package
	# intentionally does not depend on at build or run time (SPEC.md
	# section 26.2), and is exercised separately in .github/workflows/ci.yml.
	python3 chwrite.py --help >/dev/null

override_dh_auto_install:
	# File placement is entirely declarative via debian/install; there is
	# no setup.py/pyproject-driven install step to run here.
